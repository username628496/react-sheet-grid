{
  "name": "react-sheet-grid",
  "version": "0.2.0",
  "description": "A Google Sheets-style spreadsheet grid for React: canvas rendering, one million rows at 60fps, formulas, undo/redo, sorting, filtering and Vietnamese IME support.",
  "keywords": [
    "react",
    "spreadsheet",
    "grid",
    "sheet",
    "table",
    "canvas",
    "formula",
    "excel",
    "google-sheets",
    "datagrid"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/username628496/react-sheet-grid.git"
  },
  "homepage": "https://github.com/username628496/react-sheet-grid#readme",
  "bugs": {
    "url": "https://github.com/username628496/react-sheet-grid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./xlsx": {
      "import": {
        "types": "./dist/xlsx/index.d.ts",
        "default": "./dist/xlsx.js"
      },
      "require": {
        "types": "./dist/xlsx/index.d.cts",
        "default": "./dist/xlsx.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite --open /demo/",
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json && node scripts/emit-cts.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "size": "node scripts/check-size.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.1.1",
  "typesVersions": {
    "*": {
      "xlsx": [
        "./dist/xlsx/index.d.ts"
      ]
    }
  }
}
